# Which platform scripts/sync.py deploys to: vapi or bolna
PLATFORM=vapi

# Vapi: main account, and a spare account used if the main key fails
# VAPI_ACCOUNT=auto tries main then spare; set primary or spare to force one
VAPI_ACCOUNT=auto
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_API_KEY2=
VAPI_ASSISTANT_ID2=
VAPI_PUBLIC_KEY=
VAPI_PUBLIC_KEY2=

# Bolna
BOLNA_API_KEY=
BOLNA_AGENT_ID=
