# Which platform scripts/sync.py deploys to: vapi or bolna
PLATFORM=vapi

# Vapi: main account, a spare account used if the main key fails, and a third account used for tests
# VAPI_ACCOUNT=auto tries main then spare; set primary, spare or third to force one
VAPI_ACCOUNT=auto
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_API_KEY2=
VAPI_ASSISTANT_ID2=
VAPI_API_KEY3=
VAPI_ASSISTANT_ID3=
VAPI_PUBLIC_KEY=
VAPI_PUBLIC_KEY2=
VAPI_PUBLIC_KEY3=

# Bolna
BOLNA_API_KEY=
BOLNA_AGENT_ID=
